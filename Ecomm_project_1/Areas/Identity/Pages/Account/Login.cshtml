@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
<div class="login-page">
    <div class="login-container">

        <!-- Left decorative panel -->
        <div class="login-panel">
            <div class="panel-brand">
                <a class="logo-text" href="/">Kitab<span>Ghar</span></a>
                <p class="panel-tagline">Your Literary Destination</p>
            </div>

            <div class="panel-quote">
                <blockquote>"A reader lives a thousand lives before he dies."</blockquote>
                <cite>— George R.R. Martin</cite>
            </div>

            <div class="panel-books">
                <div class="book-spine bs-1"></div>
                <div class="book-spine bs-2"></div>
                <div class="book-spine bs-3"></div>
                <div class="book-spine bs-4"></div>
                <div class="book-spine bs-5"></div>
                <div class="book-spine bs-6"></div>
            </div>
        </div>

        <!-- Right form section -->
        <div class="login-form-section">
            <h1 class="form-heading">Welcome back</h1>
            <p class="form-subheading">Sign in to continue your reading journey</p>

            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <form id="account" method="post">
                <div class="field-group">
                    <label class="field-label" asp-for="Input.Email">Email Address</label>
                    <input asp-for="Input.Email"
                           class="field-input"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="you@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label class="field-label" asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password"
                           class="field-input"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="remember-row">
                    <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMe" />
                    <label for="rememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                </div>

                <button id="login-submit" type="submit" class="btn-login">Sign In</button>

                <div class="helper-links">
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create account</a>
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend confirmation</a>
                </div>
            </form>

            @{
                if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="section-divider"><span>Or continue with</span></div>

                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="ext-buttons">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit"
                                        class="btn-external"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Log in using your @provider.DisplayName account">
                                    <i class="fab fa-@provider.Name.ToLower()"></i>
                                    @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                }
            }
        </div>

    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
