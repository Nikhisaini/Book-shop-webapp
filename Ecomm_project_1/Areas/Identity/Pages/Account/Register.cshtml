@page
@using Ecomm_project_1.Utility
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/RegisterPage.css" />


<div class="register-wrapper">
    <div class="register-card">
        <!-- LEFT: Form -->
        <div class="register-left">
            <div class="register-brand">
                <div class="register-brand-icon">📚</div>
                <div class="register-brand-name">Kitab<span>Ghar</span></div>
            </div>

            <h1 class="register-heading">Create Account</h1>
            <p class="register-sub">Join thousands of readers. Start your journey today.</p>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

                <div asp-validation-summary="ModelOnly" class="validation-summary text-danger" role="alert"></div>

                <div class="form-section-label">Personal Info</div>

                <div class="form-group">
                    <label asp-for="Input.Name">Full Name</label>
                    <input asp-for="Input.Name" class="form-control" placeholder="Gurpreet Singh" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Email">Email Address</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="you@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.PhoneNumber">Phone Number</label>
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+91 98765 43210" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-section-label">Delivery Address</div>

                <div class="form-group">
                    <label asp-for="Input.StreetAddress">Street Address</label>
                    <input asp-for="Input.StreetAddress" class="form-control" placeholder="House No, Street, Area" />
                    <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.City">City</label>
                        <input asp-for="Input.City" class="form-control" placeholder="Chandigarh" />
                        <span asp-validation-for="Input.City" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.State">State</label>
                        <input asp-for="Input.State" class="form-control" placeholder="Punjab" />
                        <span asp-validation-for="Input.State" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Input.PostalCode">Postal Code</label>
                    <input asp-for="Input.PostalCode" class="form-control" placeholder="160001" />
                    <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                </div>

                <div class="form-section-label">Security</div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Password">Password</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="••••••••" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                @if (User.IsInRole(SD.Role_Admin))
                {
                    <div class="admin-section">
                        <div class="form-section-label">Admin Settings</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label asp-for="Input.Role">Role</label>
                                <select asp-for="Input.Role" class="form-control" asp-items="@Model.Input.RoleList">
                                    <option value="">Select Role</option>
                                </select>
                                <span asp-validation-for="Input.Role" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Input.CompanyID">Company</label>
                                <select asp-for="Input.CompanyID" class="form-control" asp-items="@Model.Input.CompanyList">
                                    <option value="">Select Company</option>
                                </select>
                                <span asp-validation-for="Input.CompanyID" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                }

                <button id="registerSubmit" type="submit" class="btn-register">Create My Account</button>
            </form>
        </div>

        <!-- RIGHT: Social Login -->
        <div class="register-right">
            <h2 class="social-heading">Quick Registration</h2>
            <p class="social-sub">Use an existing account to sign up instantly.</p>

            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <p style="color:var(--text-muted); font-size:13px; line-height:1.7;">
                        No external authentication services are configured.
                        <a href="https://go.microsoft.com/fwlink/?LinkID=532715" style="color:var(--green-deep);">Learn how to set them up.</a>
                    </p>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="social-btn" name="provider" value="@provider.Name" title="@provider.DisplayName account">
                                <i class="fab fa-@provider.Name.ToLower()"></i>
                                Continue with @provider.DisplayName
                            </button>
                        }
                    </form>
                }
            }

            <div class="social-divider">or</div>

            <div style="background:var(--white); border:1px solid var(--border); border-radius:var(--radius); padding:20px; text-align:center;">
                <div style="font-size:28px; margin-bottom:10px;">📖</div>
                <div style="font-family:'Playfair Display',serif; font-size:16px; color:var(--text-dark); margin-bottom:6px;">Your next great read awaits</div>
                <div style="font-size:13px; color:var(--text-muted); font-weight:300; line-height:1.6;">Register to track orders, save wishlists, and get personalized recommendations.</div>
            </div>

            <div class="login-prompt">
                Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign In →</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
