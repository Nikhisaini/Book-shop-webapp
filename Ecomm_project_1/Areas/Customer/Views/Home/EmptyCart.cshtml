<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

<style>
    .cart-empty-wrapper {
        min-height: 25vh;
        background: #f7f3ee;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1px 80px;
        font-family: 'Lato', sans-serif;
    }

    .cart-page-title {
        width: 100%;
        padding: 20px 0 0 48px;
        background: #f7f3ee;
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 600;
        color: #1c1c1c;
        letter-spacing: -0.3px;
    }

    .cart-empty-card {
        background: #ffffff;
        border: 1px solid #e0d8ce;
        border-radius: 20px;
        box-shadow: 0 8px 40px rgba(30,58,47,0.10);
        padding: 56px 64px;
        text-align: center;
        max-width: 480px;
        width: 100%;
        margin-top: 32px;
        position: relative;
        overflow: hidden;
    }

        /* Decorative top stripe */
        .cart-empty-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #1e3a2f, #c4853a, #1e3a2f);
        }

    .cart-icon-wrap {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #f0ebe3, #e8e0d5);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 28px;
        border: 2px solid #e0d8ce;
    }

        .cart-icon-wrap svg {
            width: 48px;
            height: 48px;
            color: #1e3a2f;
        }

    .cart-empty-title {
        font-family: 'Playfair Display', serif;
        font-size: 26px;
        font-weight: 600;
        color: #1c1c1c;
        margin-bottom: 10px;
    }

    .cart-empty-sub {
        font-size: 15px;
        color: #7a6a5a;
        font-weight: 300;
        line-height: 1.7;
        margin-bottom: 32px;
    }

        .cart-empty-sub span {
            color: #c4853a;
            font-style: italic;
        }

    .btn-start-shopping {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 13px 32px;
        background: #1e3a2f;
        color: #ffffff;
        font-family: 'Lato', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        text-decoration: none;
        border-radius: 8px;
        transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 4px 14px rgba(30,58,47,0.18);
    }

        .btn-start-shopping:hover {
            background: #2d5a45;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(30,58,47,0.22);
            color: #ffffff;
            text-decoration: none;
        }

        .btn-start-shopping:active {
            transform: translateY(0);
        }

        .btn-start-shopping svg {
            width: 16px;
            height: 16px;
        }

    .cart-empty-tags {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 28px;
        flex-wrap: wrap;
    }

    .cart-tag {
        background: #f0ebe3;
        border: 1px solid #e0d8ce;
        border-radius: 20px;
        padding: 5px 14px;
        font-size: 12px;
        color: #5a4e44;
        font-weight: 400;
    }

        .cart-tag strong {
            color: #1e3a2f;
            font-weight: 700;
        }
</style>

<div class="cart-page-title">Shopping Cart</div>

<div class="cart-empty-wrapper">
    <div class="cart-empty-card">
        <div class="cart-icon-wrap">
            <!-- Shopping cart SVG icon -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                <circle cx="9" cy="21" r="1" />
                <circle cx="20" cy="21" r="1" />
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
            </svg>
        </div>

        <h2 class="cart-empty-title">Your cart is empty</h2>
        <p class="cart-empty-sub">
            Looks like you haven't added any <span>books</span> yet.<br>
            Explore our collection and find your next great read.
        </p>

        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn-start-shopping">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            Browse Books
        </a>

        <div class="cart-empty-tags">
            <span class="cart-tag"><strong>Free</strong> shipping over ₹499</span>
            <span class="cart-tag"><strong>Easy</strong> 30-day returns</span>
            <span class="cart-tag"><strong>Gift</strong> wrapping available</span>
        </div>
    </div>
</div>
