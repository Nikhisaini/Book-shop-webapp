    @model  Ecomm_project_1.Models.ViewModels.OrderDetailVM

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-light py-3">
            <h3 class="text-white mb-0">Order Details - #@Model.OrderHeader.Id</h3>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="text-primary">Order Info</h5>
                    <p class="mb-1"><strong>Name:</strong> @Model.OrderHeader.Name</p>
                    <p class="mb-1"><strong>Order Date:</strong> @Model.OrderHeader.OrderDate.ToShortDateString()</p>
                    <p class="mb-1"><strong>Total:</strong> @Model.OrderHeader.OrderTotal.ToString("c")</p>
                </div>
            </div>

            <h5 class="text-primary mt-4">Products in this Order</h5>
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Product ID</th>
                        <th>Product Name</th>
                        <th>Quantity</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.OrderDetails)
                    {
                        <tr>
                            <td>@detail.ProductId</td>
                            <td>@detail.product.Title</td>
                            <td>@detail.Count</td>
                            <td>
                                <form method="post" asp-action="ReorderItem" asp-controller="Order">
                                    <input type="hidden" name="productId" value="@detail.ProductId" />
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-shopping-cart"></i> Re-Order
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            <a asp-action="PreviousOrders" class="btn btn-outline-primary mt-3">Back to Orders</a>
        </div>
    </div>
</div>