@model Ecomm_project_1.Models.ViewModels.ShoppingCartVM

@if (Model.ListCart.Any() || (Model.SharedCarts != null && Model.SharedCarts.Any()))
{
    <form method="post" id="cartForm" asp-action="Index">
        <div class="custom-cart-page">
            <br />
            <div class="backgroundWhiteBorder">
                <div class="container">
                    <div class="card">
                        <div class="card-header bg-dark text-light ml-0 row container">
                            <div class="col-6">
                                <i class="fa fa-shopping-cart"></i> &nbsp;
                                Shopping Cart
                            </div>
                            <div class="col-6 text-right">
                                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-info btn-sm mb-1">Continue Shopping</a>
                                
                                <button type="button" class="btn btn-outline-info btn-sm mb-1" data-bs-toggle="modal" data-bs-target="#shareCartModal">
                                    <i class="fas fa-share-alt"></i> Share Cart
                                </button>
                            </div>
                        </div>
                       
                        <div class="card-body">
                            <div class="col-12 mt-2">
                                <input type="checkbox" id="selectAll" />
                                <label for="selectAll" class="text-dark mb-0">Select All Products</label>
                            </div>
                            
                            @foreach (var list in Model.ListCart)
                            {
                                <div class="row">
                                    <div>
                                        <input type="checkbox" name="selectedItems" value="@list.Id" class="cart-item-checkbox"
                                               data-price="@list.Price" data-count="@list.Count" @(list.IsSelected ? "checked" : "") />
                                    </div>

                                    <div class="d-none d-lg-block col-lg-1 text-center py-2">
                                        <img src="@list.product.ImageUrl" class="rounded" width="100%" alt="@list.product.Title" />
                                    </div>
                                    <div class="col-12 text-sm-center col-lg-6 text-lg-left">
                                        <h5><strong>@list.product.Title</strong></h5>
                                        <p><small>@Html.Raw(list.product.Description)</small></p>
                                    </div>
                                    <div class="col-12 text-sm-center col-lg-5 text-lg-right row">
                                        <div class="col-3 text-md-right" style="padding-top:5px;">
                                            <h6><strong>₹@list.Price <span class="text-muted">x</span> @list.Count=@(list.Price * list.Count) </strong></h6>
                                        </div>
                                        <div class="col-3 col-sm-4 col-lg-6">
                                            <div class="float-right mx-1">
                                                <a asp-action="plus" asp-route-Id="@list.Id" class="btn btn-primary">
                                                    <i class="fas fa-plus"></i>
                                                </a>
                                            </div>
                                            <div class="float-right mx-1">
                                                <a asp-action="minus" asp-route-Id="@list.Id" class="btn btn-danger">
                                                    <i class="fas fa-minus"></i>
                                                </a>
                                            </div>
                                        </div>
                                        <div class=" col-sm-4 col-lg-2 text-right">
                                            <a asp-action="delete" onclick="return valData(event,this)" asp-route-Id="@list.Id" class="btn btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Model.SharedCarts != null && Model.SharedCarts.Any())
                            {
                                <div class="mt-4 pt-3 border-top">
                                    <h5 class="text-info"><i class="fas fa-users"></i> Group Order (Shared With You)</h5>
                                    
                                    @foreach (var sharedItem in Model.SharedCarts)
                                    {
                                        <div class="row mb-2 py-2 border rounded bg-light align-items-center">
                                            <div class="d-none d-lg-block col-lg-1 text-center">
                                                <img src="@sharedItem.ShoppingCart.product.ImageUrl" class="rounded" width="100%" />
                                            </div>
                                            <div class="col-12 col-lg-7">
                                                <h6 class="mb-0"><strong>@sharedItem.ShoppingCart.product.Title</strong></h6>
                                                <small class="text-muted">Added by: @sharedItem.ShoppingCart.applicationUser.Name (@sharedItem.ShoppingCart.applicationUser.Email)</small>
                                            </div>
                                            <div class="col-12 col-lg-4 text-right">
                                                <h6><strong>Qty: @sharedItem.ShoppingCart.Count</strong></h6>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <hr />
                            
                            <div class="row">
                                <div class="col-12 col-md-6 offset-md-6 col-lg-4 offset-lg-8 pr-4">
                                    <ul class="list-group">
                                        <li class="list-group-item d-flex justify-content-between bg-light">
                                            <span class="text-info"> Total (INR)</span>
                                            <strong class="text-info">₹ <span id="txtOrderTotal">@Model.OrderHeader.OrderTotal</span></strong>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card-footer">
                            <div class="row">
                                @if (!Model.OrderHeader.applicationUser.EmailConfirmed)
                                {
                                    <div class="col-8" @ViewBag.EmailCSS>
                                        @ViewBag.EmailMessage
                                    </div>
                                    <div class="col-4">
                                        <button type="submit" class="btn btn-outline-warning">
                                            Click here to resend Confirmation Email!!!
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-sm-12 col-lg-4 col-md-6 offset-lg-8 offset-md-6 ">
                                        @if (Model.SharedCarts != null && Model.SharedCarts.Any())
                                        {
                                            <div class="alert alert-info text-center p-2 mb-2">
                                                <small><i class="fas fa-lock"></i> Group Order Active. Only the Host can proceed to checkout.</small>
                                            </div>
                                            <button type="button" class="btn btn-secondary form-control" disabled>Summary Disabled</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-success form-control">Summary</button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
}
else
{
    <div class="container text-center mt-5 mb-5">
        
        <div class="card p-5 mx-auto" style="max-width: 400px;">
            <h3>Your cart is empty</h3>
            <p class="text-muted">Looks like you haven't added any books yet.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark">BROWSE BOOKS</a>
        </div>
        
    </div>
}

<div class="modal fade" id="shareCartModal" tabindex="-1" role="dialog" aria-labelledby="shareCartModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="shareCartModalLabel">Invite Friends to Group Order</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="email" id="friendEmailInput" class="form-control" placeholder="Enter friend's email">
                    <div class="input-group-append">
                        <button class="btn btn-outline-primary" type="button" id="addUserBtn">Add</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm mt-2">
                        <thead class="thead-light">
                            <tr>
                                <th>User Email</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="sharedUsersTableBody">
                            <tr>
                                <td colspan="2" class="text-center text-muted">No users added yet.</td>
                           </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmShareCartBtn">Share Cart</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function valData(event, element) {
        event.preventDefault();
        Swal.fire({
        title: 'Are you sure?',
        text: "You won't be able to revert this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Delete'
        }).then((result) => {
        if (result.isConfirmed) {
        window.location.href = element.href;
        }
        });
        return false;
        }

        document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('cartForm');
        if(form) {
        form.addEventListener('submit', function (e) {
        const checkedCount = document.querySelectorAll('.cart-item-checkbox:checked').length;
        if (checkedCount === 0) {
        e.preventDefault();
        Swal.fire({
        title: 'Selection Required',
        text: 'Please select at least one product before clicking Summary.',
        icon: 'warning',
        confirmButtonColor: '#3085d6'
        });
        }
        });
        }
        });

        function updateTotal() {
        let total = 0;
        document.querySelectorAll('.cart-item-checkbox:checked').forEach(cb => {
        const price = parseFloat(cb.getAttribute('data-price'));
        const count = parseInt(cb.getAttribute('data-count'));
        total += price * count;
        });
        const totalEl = document.getElementById('txtOrderTotal');
        if(totalEl) totalEl.innerText = total.toFixed(2);
        }

        document.querySelectorAll('.cart-item-checkbox').forEach(cb => {
        cb.addEventListener('change', updateTotal);
        });
        
        const selectAllCb = document.getElementById('selectAll');
        if(selectAllCb) {
        selectAllCb.addEventListener('change', function () {
        document.querySelectorAll('.cart-item-checkbox').forEach(cb => {
        cb.checked = this.checked;
        });
        updateTotal();
        });
        }

        let pendingUsers = [];
        let existingUsers = [];

        const shareModalEl = document.getElementById('shareCartModal');
        if(shareModalEl) {
        shareModalEl.addEventListener('show.bs.modal', function () {
        fetch('/Customer/Cart/GetSharedUsers')
        .then(res => res.json())
        .then(data => {
        if(data.success) {
        existingUsers = data.emails;
        pendingUsers = [];
        renderUsersTable();
        }
        });
        });
        }

        document.getElementById('addUserBtn').addEventListener('click', function() {
        const emailInput = document.getElementById('friendEmailInput');
        const email = emailInput.value.trim();

        if (!email || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
        Swal.fire('Invalid Email', 'Please enter a valid email address.', 'error');
        return;
        }
            
        if (pendingUsers.includes(email) || existingUsers.includes(email)) {
        Swal.fire('Oops!', 'This user is already on the list.', 'info');
        return;
        }

        pendingUsers.push(email);
        emailInput.value = '';
        renderUsersTable();
        });

        function renderUsersTable() {
        const tableBody = document.getElementById('sharedUsersTableBody');
        tableBody.innerHTML = '';

        if(pendingUsers.length === 0 && existingUsers.length === 0) {
        tableBody.innerHTML = '<tr><td colspan="2" class="text-center text-muted">No users added yet.</td></tr>';
        return;
        }

        existingUsers.forEach((userEmail) => {
        tableBody.innerHTML += `
        <tr>
        <td class="align-middle">
        ${userEmail}
        <span class="badge bg-secondary text-light ms-2" style="font-size:0.7rem;">Active</span>
        </td>
        <td class="text-center">
        <button type="button" class="btn btn-sm btn-outline-danger" onclick="revokeUser('${userEmail}')">
        Revoke
        </button>
        </td>
        </tr>
        `;
        });

        pendingUsers.forEach((userEmail) => {
        tableBody.innerHTML += `
        <tr>
        <td class="align-middle">
        ${userEmail}
        <span class="badge bg-warning text-dark ms-2" style="font-size:0.7rem;">Pending</span>
        </td>
        <td class="text-center">
        <button type="button" class="btn btn-sm btn-danger" onclick="removePendingUser('${userEmail}')">
        <i class="fas fa-trash"></i>
        </button>
        </td>
        </tr>
        `;
        });
        }

        function removePendingUser(emailToRemove) {
        pendingUsers = pendingUsers.filter(email => email !== emailToRemove);
        renderUsersTable();
        }

        function revokeUser(emailToRemove) {
        Swal.fire({
        title: 'Revoke Access?',
        text: `${emailToRemove} will be removed from this Group Order.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Yes, remove them'
        }).then((result) => {
        if (result.isConfirmed) {
        fetch('/Customer/Cart/RemoveSharedUser', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(emailToRemove)
        })
        .then(res => res.json())
        .then(data => {
        if(data.success) {
        existingUsers = existingUsers.filter(email => email !== emailToRemove);
        renderUsersTable();
        Swal.fire('Removed!', 'User has been removed.', 'success');
        } else {
        Swal.fire('Error', data.message, 'error');
        }
        });
        }
        });
        }

        document.getElementById('confirmShareCartBtn').addEventListener('click', function() {
        if (pendingUsers.length === 0) {
        Swal.fire('Nothing to save', 'Please add a new email address first.', 'info');
        return;
        }

        const btn = this;
        btn.disabled = true;
        btn.innerText = "Sharing...";

        fetch('/Customer/Cart/ShareCart', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json'
        },
        body: JSON.stringify(pendingUsers)
        })
        .then(response => response.json())
        .then(data => {
        if (data.success) {
        Swal.fire('Success!', data.message, 'success').then(() => {
        existingUsers = existingUsers.concat(pendingUsers);
        pendingUsers = [];
        $('#shareCartModal').modal('hide');
        renderUsersTable();
        });
        } else {
        Swal.fire('Error', data.message, 'error');
        }
        })
        .catch(error => {
        console.error('Error:', error);
        Swal.fire('Error', 'An unexpected error occurred.', 'error');
        })
        .finally(() => {
        btn.disabled = false;
        btn.innerText = "Share Cart";
        });
        });
    </script>
}