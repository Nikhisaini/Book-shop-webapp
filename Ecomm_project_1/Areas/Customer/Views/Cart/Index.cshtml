@model Ecomm_project_1.Models.ViewModels.ShoppingCartVM
<form method="post" id="cartForm" asp-action="Index">
    <div class="custom-cart-page">
        <br />
        <div class="backgroundWhiteBorder">
            <div class="container">
                <div class="card">
                    <div class="card-header bg-dark text-light ml-0 row container">
                        <div class="col-6">
                            <i class="fa fa-shopping-cart"></i> &nbsp;
                            Shopping Cart
                        </div>
                        <div class="col-6 text-right">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-info btn-sm">Continue Shopping</a>
                        </div>
                    </div>
                   
                    <div class="card-body">
                        <div class="col-12 mt-2">
                            <input type="checkbox" id="selectAll" />
                            <label for="selectAll" class="text-dark mb-0">Select All</label>
                        </div>
                        @foreach (var list in Model.ListCart)
                        {
                            <div class="row">
                                @* Individual Select *@
                                <div>
                                    <input type="checkbox" name="selectedItems" value="@list.Id" class="cart-item-checkbox"
                                           data-price="@list.Price" data-count="@list.Count" @(list.IsSelected ? "checked" : "") />
                                </div>

                                <div class="d-none d-lg-block col-lg-1 text-center py-2">
                                    <img src="@list.product.ImageUrl" class="rounded" width="100%" alt="@list.product.Title" />
                                </div>
                                <div class="col-12 text-sm-center col-lg-6 text-lg-left">
                                    <h5><strong>@list.product.Title</strong></h5>
                                    <p><small>@Html.Raw(list.product.Description)</small></p>
                                </div>
                                <div class="col-12 text-sm-center col-lg-5 text-lg-right row">
                                    <div class="col-3 text-md-right" style="padding-top:5px;">
                                        <h6><strong>₹@list.Price <span class="text-muted">x</span> @list.Count=@(list.Price * list.Count) </strong></h6>
                                    </div>
                                    <div class="col-3 col-sm-4 col-lg-6">
                                        <div class="float-right mx-1">
                                            <a asp-action="plus" asp-route-Id="@list.Id" class="btn btn-primary">
                                                <i class="fas fa-plus"></i>
                                            </a>
                                        </div>
                                        <div class="float-right mx-1">
                                            <a asp-action="minus" asp-route-Id="@list.Id" class="btn btn-danger">
                                                <i class="fas fa-minus"></i>
                                            </a>
                                        </div>
                                    </div>
                                    <div class=" col-sm-4 col-lg-2 text-right">
                                        <a asp-action="delete" onclick="return valData(event,this)" asp-route-Id="@list.Id" class="btn btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-12 col-md-6 offset-md-6 col-lg-4 offset-lg-8 pr-4">
                                <ul class="list-group">
                                    <li class="list-group-item d-flex justify-content-between bg-light">
                                        <span class="text-info"> Total (INR)</span>
                                        <strong class="text-info">₹ <span id="txtOrderTotal">@Model.OrderHeader.OrderTotal</span></strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="row">
                            @if (!Model.OrderHeader.applicationUser.EmailConfirmed)
                            {
                                <div class="col-8" @ViewBag.EmailCSS>
                                    @ViewBag.EmailMessage
                                </div>
                                <div class="col-4">
                                    <button type="submit" class="btn btn-outline-warning">
                                        Click here to resend Confirmation Email!!!
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="col-sm-12 col-lg-4 col-md-6 offset-lg-8 offset-md-6 ">
                                    <button type="submit" class="btn btn-success form-control">Summary</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
@section scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        //Delete PopUp
        function valData(event, element) {
        event.preventDefault();
          
        Swal.fire({
        title: 'Are you sure?',
        text: "You won't be able to revert this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Delete'
        }).then((result) => {
        if (result.isConfirmed) {
        window.location.href = element.href;
        }
        });
        return false;
        }

        // Empty Selection Message
        document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('cartForm');

        form.addEventListener('submit', function (e) {
        const checkedCount = document.querySelectorAll('.cart-item-checkbox:checked').length;

        if (checkedCount === 0) {
        e.preventDefault();

        Swal.fire({
        title: 'Selection Required',
        text: 'Please select at least one product before clicking Summary.',
        icon: 'warning',
        confirmButtonColor: '#3085d6'
        });
        }
        });
        });
        //updatetotla according to selection
        function updateTotal()
        {
        let total = 0;
        document.querySelectorAll('.cart-item-checkbox:checked').forEach(cb => {
        const price = parseFloat(cb.getAttribute('data-price'));
        const count = parseInt(cb.getAttribute('data-count'));
        total += price * count;
        });
        document.getElementById('txtOrderTotal').innerText = total.toFixed(2);
        }

        document.querySelectorAll('.cart-item-checkbox').forEach(cb => { cb.addEventListener('change', updateTotal);
        });
        document.getElementById('selectAll').addEventListener('change', function () {
        document.querySelectorAll('.cart-item-checkbox').forEach(cb => {
        cb.checked = this.checked;
        });
        updateTotal();
        });
    </script>

    
}

